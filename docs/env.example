# ============================================
# LEGAL PRACTICE MANAGEMENT PLATFORM - ENVIRONMENT CONFIG
# ============================================
# Only environment-specific values and secrets here.
# Static config lives in src/core/constants/
# Replace every <PLACEHOLDER> below with your own project's values —
# none of the credentials from the previous project should be reused here.

# Directus API (REQUIRED)
NEXT_PUBLIC_DIRECTUS_URL=<PLACEHOLDER_DIRECTUS_URL>
DIRECTUS_ADMIN_TOKEN=<PLACEHOLDER_DIRECTUS_ADMIN_TOKEN>

# Directus Folder IDs (for file uploads to correct folders)
DIRECTUS_USER_AVATARS_FOLDER_ID=<PLACEHOLDER_FOLDER_ID>
DIRECTUS_SUPPORT_FOLDER_ID=<PLACEHOLDER_FOLDER_ID>
DIRECTUS_CASE_DOCUMENTS_FOLDER_ID=<PLACEHOLDER_FOLDER_ID>
DIRECTUS_CHAT_MESSAGES_FOLDER_ID=<PLACEHOLDER_FOLDER_ID>
DIRECTUS_LAWYER_VERIFICATIONS_FOLDER_ID=<PLACEHOLDER_FOLDER_ID>

# Directus Role IDs (REQUIRED for onboarding)
# Pulled from your real Directus roles export — flat roles, each tied to a policy
# (not a parent/child tree; use `policies` in Directus for permission composition).
DIRECTUS_ROLE_DEFAULT=960cb8b1-ad94-4326-ac29-b2a372212b12
DIRECTUS_ROLE_ADMINISTRATOR=a59be116-12c5-4be9-bb72-b73158a6d75e
DIRECTUS_ROLE_MANAGER=1cc8fb8d-9589-44a5-8b9f-6f61885bda72
DIRECTUS_ROLE_OFFICE_LAW=1e2f0717-dee5-4cd3-825a-793c4b4217a0
DIRECTUS_ROLE_LAWYER=ebe4fd75-8771-4a04-9715-b438ce6e5e23
DIRECTUS_ROLE_TRAINEE=6aa30e64-942b-4f4a-9fa6-11865d4d510e
DIRECTUS_ROLE_EMPLOYEE=a1c7012f-3b98-412f-8f27-039362abf963
DIRECTUS_ROLE_CLIENT=156b4aaf-06ab-4c44-9271-6c12bf2e8add
DIRECTUS_ROLE_ORGANIZATION_CLIENT=8de11653-a06e-4c9c-a090-ba989165f1bf
DIRECTUS_ROLE_ORGANIZATION_CLIENT_TEAM=20e25bc2-3e04-4361-a0f8-54999314db0e
DIRECTUS_ROLE_READER=27bff82c-7ec3-4b0e-b65a-af456b9f0aa2

# Directus User Registration Verification URL
# Must match USER_REGISTER_URL_ALLOW_LIST in directus.env
NEXT_PUBLIC_VERIFICATION_URL=http://localhost:3000/auth/verify-email

# Password Reset URL
# Must match PASSWORD_RESET_URL_ALLOW_LIST in directus.env
NEXT_PUBLIC_PASSWORD_RESET_URL=http://localhost:3000/auth/reset-password

# User Invite URL
# Must match USER_INVITE_URL_ALLOW_LIST in directus.env
NEXT_PUBLIC_INVITE_URL=http://localhost:3000/auth/accept-invite

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# External Services
OPENAI_API_KEY=<PLACEHOLDER_OPENAI_API_KEY>

# Node Environment
NODE_ENV=development

# Google auth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<PLACEHOLDER_GOOGLE_CLIENT_ID>

# Public Mapbox access token used for frontend map features (e.g. office/court locations)
NEXT_PUBLIC_MAPBOX_TOKEN=<PLACEHOLDER_MAPBOX_TOKEN>

# Web Push Notifications (VAPID protocol)
# Generate via: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<PLACEHOLDER_VAPID_PUBLIC_KEY>
VAPID_PRIVATE_KEY=<PLACEHOLDER_VAPID_PRIVATE_KEY>
VAPID_SUBJECT=mailto:support@yourdomain.com

# Internal API Secret — used by Directus flows to call the app's push/notification API (server-to-server)
INTERNAL_API_SECRET=<PLACEHOLDER_INTERNAL_API_SECRET>

# Region Detection — Dev Override
# In local dev there are no Vercel/Cloudflare geo headers,
# so we set the default region manually.
# Remove these in production — real geo headers will be used instead.
DEFAULT_REGION_COUNTRY=EG
DEFAULT_REGION_CITY=Cairo
